# Local Development Environment (recommended for development)
DEBUG=True
SECRET_KEY=django-insecure-dev-local-only-change-in-production
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require
# Use local Redis for development to eliminate WAN latency (run: redis-server)
REDIS_URL=redis://127.0.0.1:6379/0
ALLOWED_HOSTS=127.0.0.1,localhost
REDIS_KEY_PREFIX=
# Celery also uses local Redis in development
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/0
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# For Production/Render deployment:
# DEBUG=False
# SECRET_KEY=<generate-secure-key>
# DATABASE_URL=<render-postgres-url>
# REDIS_URL=<upstash-redis-url>
# ALLOWED_HOSTS=<your-render-domain>
# REDIS_KEY_PREFIX=
# IMPORTANT: Celery MUST use the same cloud Redis URL on Render
# CELERY_BROKER_URL=<upstash-redis-url>
# CELERY_RESULT_BACKEND=<upstash-redis-url>
